---
import { getCollection } from 'astro:content';
import ProjectPage from '../../components/pages/ProjectPage.astro';

// Hidden projects get no page at all; unlisted ones get a page but stay off
// the portfolio and out of search.
export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all
    .filter((p) => p.data.visibility !== 'hidden')
    .map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}
const { project } = Astro.props;
---
<ProjectPage project={project} />
