---
import '../styles/global.css';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import Lightbox from '../components/sections/Lightbox.astro';
// Classic script, not a module: the markup calls its functions from onclick
// attributes, so they have to live on window.
import legacyJs from '../scripts/legacy.js?raw';

interface Props {
  title?: string;
  description?: string;
  // An unlisted project is reachable by link only. If a search engine indexed
  // its page, it would stop being unlisted.
  noindex?: boolean;
  // A page sent on its own, such as a single project: no menu, so it does not
  // open onto the rest of the portfolio.
  standalone?: boolean;
}
const {
  title = 'Aniol Escofet — Industrial Engineer',
  description = 'Automotive engineer working on vehicle dynamics, control systems and performance simulation.',
  noindex = false,
  standalone = false,
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex, nofollow">}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<meta name="theme-color" content="#F8F7F4" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#16181B" media="(prefers-color-scheme: dark)">
<!-- Set the theme before the first paint, so a dark page never flashes light:
     the visitor's saved choice, otherwise the system setting. -->
<script is:inline>
(function(){var t;try{t=localStorage.getItem('theme')}catch(e){}
if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';
document.documentElement.dataset.theme=t})();
</script>
<noscript><style>.reveal{opacity:1;transform:none}.theme-toggle{display:none}</style></noscript>
</head>
<body>
<Nav links={!standalone} />
<slot />
<Footer />
<Lightbox />
<script is:inline set:html={legacyJs}></script>
</body>
</html>
