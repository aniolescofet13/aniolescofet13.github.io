---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/assets';
import Slider from '../Slider.astro';
import { useT } from '../../i18n/ui';
import { langOf } from '../../i18n/current';
const t = useT(langOf(Astro.currentLocale)).experience;

// What does not change with the language: logos and photos.
const media = [
  { logo: 'STARK Future/logo.png', name: 'STARK Future', id: 'slider-exp-stark', photos: ['STARK Future/1.jpg', 'STARK Future/2.webp', 'STARK Future/3.jpeg'] },
  { logo: 'CUPRA Racing/logo.png', name: 'CUPRA Racing', id: 'slider-exp-cupra', photos: ['CUPRA Racing/CEE/1.webp', 'CUPRA Racing/TCR/2.jpeg', 'CUPRA Racing/CEE/5.jpg'] },
  { logo: 'BCNeMotorsport/logo.png', name: 'BCNeMotorsport', id: 'slider-exp-bcne', photos: ['BCNeMotorsport/1.jpg', 'BCNeMotorsport/2.jpg', 'BCNeMotorsport/3.jpg', 'BCNeMotorsport/4.jpg', 'BCNeMotorsport/5.jpg', 'BCNeMotorsport/6.jpg'] },
];
---
<section id="experience">
<div class="section-header reveal"><span class="section-num">02</span><h2 class="section-title">{t.title}</h2><div class="section-line"></div></div>
{t.jobs.map((job, i) => {
  const m = media[i];
  return (
    <div class="exp-item reveal"><div class="exp-date">{job.dates}<Image src={resolveImage(m.logo)} class="exp-logo" alt={m.name} loading="lazy" /></div><div class="exp-role">
    <h3>{job.role}</h3><div class="exp-company">{job.company}</div>
    <div class="exp-desc">{job.desc}</div>
    <div class="exp-tags">{job.tags.map((tag) => <span class="exp-tag">{tag}</span>)}</div>
    </div>
    <Slider id={m.id} items={m.photos.map((src) => ({ type: 'image', src, alt: m.name }))} />
    </div>
  );
})}
</section>
