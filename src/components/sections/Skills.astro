---
import { useT } from '../../i18n/ui';
import { langOf } from '../../i18n/current';
const t = useT(langOf(Astro.currentLocale)).skills;
---
<section id="skills">
<div class="section-header reveal"><span class="section-num">04</span><h2 class="section-title">{t.title}</h2><div class="section-line"></div></div>
<div class="skills-layout">
{t.blocks.map((b, i) => <div class={`skill-block reveal stagger-${i + 1}`}><h4>{b.h}</h4><ul>{b.items.map((it) => <li>{it}</li>)}</ul></div>)}
</div></section>
