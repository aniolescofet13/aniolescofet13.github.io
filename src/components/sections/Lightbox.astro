---
// The image is filled in by openLightbox() from the slide's data-full URL,
// so it starts empty and must stay a plain <img>.
import { useT } from '../../i18n/ui';
import { langOf } from '../../i18n/current';
const t = useT(langOf(Astro.currentLocale)).lightbox;
---
<div class="lightbox-overlay" id="lightbox" onclick="closeLightbox()">
<button aria-label={t.close} class="lightbox-close" onclick="closeLightbox()">×</button>
<button aria-label={t.prev} class="lightbox-nav prev" id="lb-prev" onclick="lightboxStep(-1,event)">‹</button>
<img id="lightbox-img" src="" alt={t.alt} onclick="event.stopPropagation()" />
<button aria-label={t.next} class="lightbox-nav next" id="lb-next" onclick="lightboxStep(1,event)">›</button>
<div class="lightbox-counter" id="lb-counter"></div>
</div>
