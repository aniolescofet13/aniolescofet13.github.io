---
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/assets';
import { useT } from '../../i18n/ui';
import { langOf } from '../../i18n/current';
const t = useT(langOf(Astro.currentLocale)).about;
---
<section class="parallax-bg" id="about">
<div class="section-header reveal"><span class="section-num">01</span><h2 class="section-title">{t.title}</h2><div class="section-line"></div></div>
<div class="about-text-wrap reveal">
<div class="about-id-photo"><Image src={resolveImage("About Me/ID.png")} alt="Aniol Escofet" loading="lazy" /></div>
<div class="about-text">
{t.paragraphs.map((p) => <p set:html={p} />)}
<div class="interests-row">{t.interests.map((i) => <span class="interest-tag">{i}</span>)}</div>
</div>
</div></section>
