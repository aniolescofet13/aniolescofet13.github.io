---
import { useT } from '../../i18n/ui';
import { langOf } from '../../i18n/current';
const t = useT(langOf(Astro.currentLocale)).hero;
const values = [3, 3, 2];
---
<section class="hero"><div class="hero-content">
<p class="hero-eyebrow">{t.eyebrow}</p>
<h1>{t.titleA}<br/>{t.titleB} <em>{t.titleEm}</em></h1>
<p class="hero-desc">{t.desc}</p>
<div class="hero-stats">
{values.map((v, i) => <div class="hero-stat"><span class="hero-stat-value counter" data-target={v}>0</span><span class="hero-stat-label">{t.stats[i]}</span></div>)}
<div class="hero-stat"><span class="hero-stat-value">∞</span><span class="hero-stat-label">{t.stats[3]}</span></div>
</div></div></section>
